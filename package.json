{
  "name": "radjaac-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && npm run validate:areas && npm run validate:seo && npm run validate:articles && npm run build",
    "validate:areas": "node --no-warnings scripts/validate-areas.mjs",
    "validate:seo": "node --no-warnings scripts/validate-seo.mjs",
    "validate:articles": "node --no-warnings scripts/validate-articles.mjs",
    "audit:staged": "node scripts/audit-staged.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  }
}
